From 5b6d427e916d4002a8e6451d72ec3a028f6b3662 Mon Sep 17 00:00:00 2001
From: crossainthero <billymillena@gmail.com>
Date: Sun, 1 Nov 2026 01:01:30 +1100
Subject: [PATCH] sarness: Ctrl+C cancels a command or prompt submitted a
 moment ago

A Ctrl+C that arrived after a '!' command or prompt was submitted but before the client had been told it was running
found nothing to stop: the command kept running (about one run in three in the PTY tests). A just-submitted prompt now
counts as active work, cancelling a user's shell keeps looking for a command that is not listed yet, and an interrupt
sent before the server reports a prompt running is repeated the moment it starts.
---
 packages/tui/src/component/prompt/index.tsx | 48 ++++++++++++++++++---
 packages/tui/test/sarness-ctrl-c.test.ts    |  8 ++++
 2 files changed, 49 insertions(+), 7 deletions(-)

diff --git a/packages/tui/src/component/prompt/index.tsx b/packages/tui/src/component/prompt/index.tsx
index 9a16519..30c1f4d 100644
--- a/packages/tui/src/component/prompt/index.tsx
+++ b/packages/tui/src/component/prompt/index.tsx
@@ -225,6 +225,15 @@ export function Prompt(props: PromptProps) {
   const toast = useToast()
   const status = createMemo(() => data.session.status(props.sessionID ?? ""))
   const userShells = createMemo(() => userShellsInFlight()[props.sessionID ?? ""] ?? [])
+  // Sarness: a prompt or `!` command submitted a moment ago is active work even before the server reports it running, so a
+  // Ctrl+C in that gap cancels it instead of being lost (or quitting the app).
+  const [justSubmitted, setJustSubmitted] = createSignal(false)
+  let justSubmittedTimer: ReturnType<typeof setTimeout> | undefined
+  const noteSubmit = () => {
+    setJustSubmitted(true)
+    if (justSubmittedTimer) clearTimeout(justSubmittedTimer)
+    justSubmittedTimer = setTimeout(() => setJustSubmitted(false), 1500)
+  }
   const history = usePromptHistory()
   const stash = usePromptStash()
   const keymap = Keymap.use()
@@ -575,18 +584,41 @@ export function Prompt(props: PromptProps) {
         name: "session.cancel",
         category: "Session",
         palette: undefined,
-        enabled: (status() === "running" || userShells().length > 0) && !!props.sessionID,
+        enabled: justSubmitted() || ((status() === "running" || userShells().length > 0) && !!props.sessionID),
         run: () => {
           const sessionID = props.sessionID
-          if (!sessionID) return false
+          if (!sessionID) return // just submitted into a session that is still being created: consume the key, do not quit
           setStore("interrupt", 0)
           if (store.mode === "shell" && store.prompt.text === "") setStore("mode", "normal")
-          if (status() === "running") void client.api.session.interrupt({ sessionID, resume: false })
+          if (status() === "running" || justSubmitted()) void client.api.session.interrupt({ sessionID, resume: false })
+          if (status() !== "running" && justSubmitted()) {
+            // Pressed before the server reported the prompt running: interrupt again the moment it starts.
+            let waited = 0
+            const starting = setInterval(() => {
+              if (status() === "running") {
+                void client.api.session.interrupt({ sessionID, resume: false })
+                clearInterval(starting)
+              } else if ((waited += 50) > 1500) clearInterval(starting)
+            }, 50)
+          }
           // Only the commands this composer started: a background server the agent launched keeps running.
-          const owned = userShells()
-          for (const shell of data.shell.listBySession(sessionID)) {
-            if (shell.status !== "running" || !owned.includes(shell.command)) continue
-            void client.api.shell.remove({ id: shell.id, location: { directory: shell.location.directory } })
+          const stopped = new Set<string>()
+          const stopOwned = () => {
+            const owned = userShells()
+            for (const shell of data.shell.listBySession(sessionID)) {
+              if (shell.status !== "running" || !owned.includes(shell.command) || stopped.has(shell.id)) continue
+              stopped.add(shell.id)
+              void client.api.shell.remove({ id: shell.id, location: { directory: shell.location.directory } }).catch(() => {})
+            }
+          }
+          stopOwned()
+          // The command may have been submitted a moment ago and not be listed yet: keep looking for it briefly.
+          if (userShells().length > 0) {
+            let tries = 0
+            const timer = setInterval(() => {
+              if (userShells().length === 0 || ++tries > 40) return clearInterval(timer)
+              stopOwned()
+            }, 100)
           }
           toast.show({
             title: "Cancelled",
@@ -1382,6 +1414,7 @@ export function Prompt(props: PromptProps) {
     history.append(entry)
     if (currentMode === "shell") {
       move.startSubmit()
+      noteSubmit()
       const send = () => {
         const settled = trackUserShell(target, inputText)
         return client.api.session.shell({ sessionID: target, command: inputText }).finally(settled)
@@ -1408,6 +1441,7 @@ export function Prompt(props: PromptProps) {
       )
     } else {
       move.startSubmit()
+      noteSubmit()
       if (!(await attempt("Failed to prepare session", prepareAgent))) return true
       // Revert must settle before optimistic admission: its committed echo
       // splices every local row at or after the boundary, which would include
diff --git a/packages/tui/test/sarness-ctrl-c.test.ts b/packages/tui/test/sarness-ctrl-c.test.ts
index 4924a07..74bdbe9 100644
--- a/packages/tui/test/sarness-ctrl-c.test.ts
+++ b/packages/tui/test/sarness-ctrl-c.test.ts
@@ -26,4 +26,12 @@ describe("sarness Ctrl+C", () => {
     expect(prompt).toContain("resume: false")
     expect(prompt).toContain("trackUserShell(target, inputText)")
   })
+
+  test("a prompt or `!` command submitted a moment ago can be cancelled before the server reports it running", () => {
+    const prompt = source("../src/component/prompt/index.tsx")
+    expect(prompt).toContain("const noteSubmit = () =>")
+    expect(prompt.match(/noteSubmit\(\)/g)?.length).toBeGreaterThanOrEqual(2)
+    expect(prompt).toMatch(/enabled: justSubmitted\(\) \|\| \(\(status\(\) === "running"/)
+    expect(prompt).toContain("keep looking for it briefly")
+  })
 })
