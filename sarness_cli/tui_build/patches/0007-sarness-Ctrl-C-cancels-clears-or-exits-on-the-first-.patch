index 0000000..4924a07
--- /dev/null
+++ b/packages/tui/test/sarness-ctrl-c.test.ts
@@ -0,0 +1,29 @@
+import { describe, expect, test } from "bun:test"
+import { readFileSync } from "node:fs"
+import { TuiKeybind } from "../src/config/keybind"
+
+// Sarness: one Ctrl+C always has one visible effect (cancel what runs, else clear, else exit), including while the
+// app is still starting. The behaviour is exercised end to end through a real pseudo-terminal by the Sarness CLI's
+// own test suite (tests/test_ctrl_c_tui.py); these keep the wiring from being lost in an upstream rebase.
+const source = (path: string) => readFileSync(new URL(path, import.meta.url), "utf8")
+
+describe("sarness Ctrl+C", () => {
+  test("session.cancel is bound to ctrl+c next to the deliberate escape interrupt", () => {
+    expect(TuiKeybind.Definitions["session.cancel"].default).toBe("ctrl+c")
+    expect(TuiKeybind.Definitions["session.interrupt"].default).toBe("escape")
+  })
+
+  test("the renderer exits on Ctrl+C until the app's keymap takes over (the terminal is raw, so no SIGINT arrives)", () => {
+    const app = source("../src/app.tsx")
+    expect(app).toContain("exitOnCtrlC: true")
+    expect(app).toMatch(/onMount\(\(\) => \{[\s\S]{0,300}?exitOnCtrlC: boolean[\s\S]{0,40}?exitOnCtrlC = false/)
+  })
+
+  test("cancelling outranks the input's clear and the app's exit, and covers the user's own `!` commands", () => {
+    const prompt = source("../src/component/prompt/index.tsx")
+    expect(prompt).toMatch(/priority: 2,\s*enabled: !disabled\(\),\s*bindings: \["session.cancel"\]/)
+    expect(prompt).toContain('name: "session.cancel"')
+    expect(prompt).toContain("resume: false")
+    expect(prompt).toContain("trackUserShell(target, inputText)")
+  })
+})
