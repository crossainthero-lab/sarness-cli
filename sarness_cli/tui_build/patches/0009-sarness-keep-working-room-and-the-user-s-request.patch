+    : `${text.slice(0, REQUEST_MAX_CHARS * 0.7)}\n[... ${text.length - REQUEST_MAX_CHARS} characters elided ...]\n${text.slice(-REQUEST_MAX_CHARS * 0.3)}`
+
 const recentStart = (
   entries: ReadonlyArray<{ readonly message: SessionMessage.Info; readonly text: string }>,
   keep: number,
@@ -744,8 +758,10 @@ const recentStart = (
   const latestUser = entries.findLastIndex((entry) => entry.message.type === "user")
   if (latestUser > 0) return latestUser
 
-  // One exchange, nothing older. Summarize it all and keep nothing, unless a previous summary already
-  // kept recent text, in which case keep everything and summarize only the summary before it.
+  // One exchange, nothing older: an agent run, its request followed by tool rounds. SARNESS: summarize its older steps
+  // and keep the newest ones within the allowance instead of keeping nothing; splitConversation adds the request.
+  if (dropped > 0) return dropped
+  // Everything fits the allowance: summarize it all, as before (the request is still kept beside the summary).
   return previous?.recent ? 0 : entries.length
 }
 
@@ -914,12 +930,29 @@ export const estimatePrompt = (context: SessionContext.Loaded) => {
  * is more. The summary request is capped at the same size, so its output limit is whatever the reserve leaves. A window
  * too small to give up `RESERVE_MIN` keeps 10%.
  */
-const calculateCeiling = (limit: SessionContext.Loaded["model"]["limit"], buffer: number | undefined, reserveOutput = false) => {
+/**
+ * SARNESS: tokens kept free below the window. Stock keeps a flat 16k from 32k windows up, which left a 32k local model
+ * about 5k tokens of working room beside the ~11k tokens of prompt and tool definitions, so every file read compacted
+ * the session again. From 32k to 64k the reserve is what the model can really write (its output limit, at most a
+ * quarter of the window); 64k and larger windows keep the stock reserve.
+ */
+export const defaultReserve = (window: number, output: number | undefined) => {
+  const tenth = Math.floor(window * 0.1)
+  if (window < 2 * RESERVE_MIN) return tenth
+  if (window >= 4 * RESERVE_MIN) return Math.max(tenth, RESERVE_MIN)
+  return Math.max(tenth, Math.min(output && output > 0 ? output : RESERVE_MIN, Math.floor(window / 4)))
+}
+
+/** SARNESS: the verbatim recent part may not take more than a quarter of the request budget (at least 2k tokens). */
+export const keepFor = (budget: number, keep: number) =>
+  Number.isFinite(budget) ? Math.min(keep, Math.max(2_000, Math.floor(budget / 4))) : keep
+
+export const calculateCeiling = (limit: SessionContext.Loaded["model"]["limit"], buffer: number | undefined, reserveOutput = false) => {
   // Unknown limits are reported as 0. An unknown input limit falls back to the context window; with no window at
   // all, only a provider rejection can limit the request.
   const window = limit.input || limit.context
   if (window <= 0) return Number.POSITIVE_INFINITY
-  const reserve = buffer ?? Math.max(Math.floor(window * 0.1), window >= 2 * RESERVE_MIN ? RESERVE_MIN : 0)
+  const reserve = buffer ?? defaultReserve(window, limit.output)
   // Primary requests fit their output to the remaining room. Reserve up to a quarter of the window,
   // so models advertising their whole context as output do not compact an empty session.
   const outputReserve = Math.min(limit.output || 0, Math.floor(limit.context / 4))
