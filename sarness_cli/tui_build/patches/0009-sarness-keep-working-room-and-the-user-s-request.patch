-    recent: recent.map((entry) => entry.text).join("\n\n"),
+    recent: [...request, ...recent.map((entry) => entry.text)].join("\n\n"),
   }
 }
 
+const REQUEST_MAX_CHARS = 12_000
+/** SARNESS: the user's request survives verbatim up to this size; beyond it the middle is elided, not the ends. */
+export const capRequest = (text: string) =>
