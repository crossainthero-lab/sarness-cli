+// SARNESS: a session's automatic-compaction choice. `/autocompact on|off` stores it on the session; a session that
+// has never been asked follows the launcher's default (SARNESS_AUTOCOMPACT_DEFAULT=on|off, off when unset).
+export const autoCompactEnabled = (metadata?: Record<string, unknown> | null): boolean => {
+  const chosen = metadata?.sarnessAutoCompact
+  if (typeof chosen === "boolean") return chosen
+  return process.env.SARNESS_AUTOCOMPACT_DEFAULT === "on"
