diff --git a/packages/core/test/sarness-compaction-room.test.ts b/packages/core/test/sarness-compaction-room.test.ts
new file mode 100644
index 0000000..18d8a6c
--- /dev/null
+++ b/packages/core/test/sarness-compaction-room.test.ts
@@ -0,0 +1,128 @@
+// SARNESS: compaction must leave a small local model room to work and must never lose the user's request.
+// Regression for the Trinodal sessions: a 32k window, ~11k tokens of fixed prompt, a flat 16k reserve and a "keep 15k
+// verbatim" allowance compacted the session after every one or two tool calls, and the user's own request was
+// summarized away because an agent run is a single exchange.
+import { expect, test } from "bun:test"
+import { calculateCeiling, capRequest, defaultReserve, keepFor, splitConversation } from "@opencode/core/session/compaction"
+import { toLLMMessages } from "@opencode/core/session/runner/to-llm-message"
+import { brief, entries, CATALOG_BUDGET_CHARS } from "@opencode/core/skill/instructions"
+import { autoCompactEnabled } from "@opencode/util/sarness-autocompact"
+
+const limit = (context: number, output: number, input = 0) => ({ context, output, input })
+
+test("a 32k window leaves room for work beside the fixed prompt, not ~5k tokens", () => {
+  const ceiling = calculateCeiling(limit(32768, 8192), undefined)
+  expect(ceiling).toBe(24576)
+  const fixedPrompt = 11_500
+  expect(ceiling - fixedPrompt).toBeGreaterThan(12_000)
+  // stock behaviour for the same model, for comparison: 32768 - 16000
+  expect(32768 - 16000 - fixedPrompt).toBeLessThan(5_500)
+})
+
+test("larger windows keep the stock reserve and smaller ones keep a tenth", () => {
+  expect(defaultReserve(131072, 32768)).toBe(16000)
+  expect(defaultReserve(262144, 32768)).toBe(26214)
+  expect(defaultReserve(16384, 4096)).toBe(1638)
+  expect(calculateCeiling(limit(131072, 32768), undefined)).toBe(131072 - 16000)
+  expect(calculateCeiling(limit(32768, 8192), 2000)).toBe(30768)
+})
+
+test("the verbatim part is bounded by the budget", () => {
+  expect(keepFor(24576, 15000)).toBe(6144)
+  expect(keepFor(236000, 15000)).toBe(15000)
+  expect(keepFor(4000, 15000)).toBe(2000)
+  expect(keepFor(Number.POSITIVE_INFINITY, 15000)).toBe(15000)
+})
+
+const user = (text: string) => ({ type: "user", id: "msg_u", text, files: [], skills: [] }) as any
+const assistant = (n: number, result = "x".repeat(400)) =>
+  ({
+    type: "assistant",
+    id: `msg_a${n}`,
+    content: [
+      { type: "text", text: `step ${n}` },
+      { type: "tool", name: "shell", state: { status: "completed", input: { command: `cmd ${n}` }, content: [{ type: "text", text: result }] } },
+    ],
+  }) as any
+
+test("a single long agent run keeps the user's request word for word and its newest steps", () => {
+  const directive = "SSH into the Spark, inspect Trinodal, fix the bug, run tests and deploy. Proceed autonomously."
+  const messages = [user(directive), ...Array.from({ length: 30 }, (_, i) => assistant(i))]
+  const split = splitConversation(messages, 600)!
+  expect(split.recent).toContain(`[User]: ${directive}`)
+  expect(split.recent).toContain("step 29")
+  expect(split.recent).not.toContain("step 0\n")
+  expect(split.older.length).toBeGreaterThan(20)
+  expect(split.recent.indexOf("[User]")).toBeLessThan(split.recent.indexOf("step 29"))
+})
+
+test("a directive compacted before any work is not lost", () => {
+  const directive = "x".repeat(300)
+  const split = splitConversation([user(directive)], 15000)!
+  expect(split.recent).toContain(`[User]: ${directive}`)
+  expect(split.older).toHaveLength(1)
+})
+
+test("a short conversation is still summarized whole, with the request kept beside the summary", () => {
+  const split = splitConversation([user("do the thing"), assistant(1)], 15000)!
+  expect(split.older).toHaveLength(2)
+  expect(split.recent).toContain("[User]: do the thing")
+  expect(split.recent).not.toContain("step 1")
+})
+
+test("an ordinary multi-exchange conversation is split as before", () => {
+  const messages = [user("first"), assistant(1), user("second"), assistant(2), user("third"), assistant(3)]
+  const split = splitConversation(messages, 400)!
+  expect(split.recent.startsWith("[User]: third")).toBe(true)
+  expect(split.recent).not.toContain("[earlier steps are in the summary]")
+})
+
+test("a huge request is elided in the middle, never at its ends", () => {
+  const text = `HEAD${"m".repeat(40000)}TAIL`
+  const capped = capRequest(text)
+  expect(capped.startsWith("HEAD")).toBe(true)
+  expect(capped.endsWith("TAIL")).toBe(true)
+  expect(capped.length).toBeLessThan(13000)
+  expect(capRequest("short")).toBe("short")
+})
+
+test("the checkpoint does not tell the model to ignore the user's request", () => {
+  const [message] = toLLMMessages(
+    [{ type: "compaction", id: "msg_c", status: "completed", summary: "## Objective\n- do the task", recent: "[User]: do the task" } as any],
+    { providerID: "sarness", modelID: "m" } as any,
+  )
+  const text = JSON.stringify(message.content)
+  expect(text).toContain("still in progress and still in force")
+  expect(text).toContain("without asking the user whether to proceed")
+  expect(text).not.toContain("not as new instructions")
+})
+
+test("a catalog of many skills shrinks to one sentence each while a small one stays whole", () => {
+  const long = (i: number) => ({
+    id: `s${i}` as any,
+    name: `skill-${i}` as any,
+    description: `Does thing ${i} for you. Use it when the task is ${"very ".repeat(40)}specific, and also when asked nicely.`,
+  })
+  const many = entries(Array.from({ length: 42 }, (_, i) => long(i))).join("\n")
+  expect(many.length).toBeLessThan(CATALOG_BUDGET_CHARS)
+  expect(many).toContain("Does thing 3 for you.")
+  expect(many).not.toContain("asked nicely")
+  const few = entries([long(1), long(2)]).join("\n")
+  expect(few).toContain("asked nicely")
+  expect(brief("One. Two.")).toBe("One.")
+})
+
+test("a session follows its own choice, else the launcher's default", () => {
+  const before = process.env.SARNESS_AUTOCOMPACT_DEFAULT
+  try {
+    delete process.env.SARNESS_AUTOCOMPACT_DEFAULT
+    expect(autoCompactEnabled(undefined)).toBe(false)
+    expect(autoCompactEnabled({ sarnessAutoCompact: true })).toBe(true)
+    process.env.SARNESS_AUTOCOMPACT_DEFAULT = "on"
+    expect(autoCompactEnabled({})).toBe(true)
+    expect(autoCompactEnabled({ sarnessAutoCompact: false })).toBe(false)
+  } finally {
+    if (before === undefined) delete process.env.SARNESS_AUTOCOMPACT_DEFAULT
+    else process.env.SARNESS_AUTOCOMPACT_DEFAULT = before
+  }
+})
