-const entries = (skills: ReadonlyArray<Summary>) =>
+// SARNESS: with many skills installed the full descriptions cost thousands of tokens on every request (42 skills were
+// ~6.5k tokens of a 32k window). Past this size each entry shrinks to its first sentence; the skill tool still loads
+// the complete text on demand.
+export const CATALOG_BUDGET_CHARS = 6_000
+export const brief = (text: string) => {
+  const one = text.replace(/\s+/g, " ").trim()
+  const sentence = one.match(/^.*?[.!?](?=\s|$)/)?.[0] ?? one
+  return sentence.length <= 110 ? sentence : `${sentence.slice(0, 109).trimEnd()}…`
+}
+
+const entryLines = (skills: ReadonlyArray<Summary>, describe: (skill: Summary) => string) =>
   skills.flatMap((skill) => [
     "  <skill>",
     `    <id>${skill.id}</id>`,
     `    <name>${skill.name}</name>`,
-    `    <description>${skill.description}</description>`,
+    `    <description>${describe(skill)}</description>`,
     "  </skill>",
   ])
 
+export const entries = (skills: ReadonlyArray<Summary>) => {
+  const full = entryLines(skills, (skill) => skill.description)
+  return full.join("\n").length <= CATALOG_BUDGET_CHARS ? full : entryLines(skills, (skill) => brief(skill.description))
+}
