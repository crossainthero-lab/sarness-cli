@@ -1,6 +1,7 @@
 import { RGBA, TextAttributes } from "@opentui/core"
 import { useTerminalDimensions } from "@opentui/solid"
-import { createMemo, Show } from "solid-js"
+import { createMemo, For, Show } from "solid-js"
+import { SarnessLaunch, sarnessEffortLabel, sarnessModeLabel } from "../../sarness"
 import { useTheme } from "../../context/theme"
 import { Locale } from "../../util/locale"
 import { stringWidth } from "../../util/string-width"
@@ -144,3 +145,65 @@ function text(input: Layout) {
     ...(input.variant ? ["·", input.variant] : []),
   ].join(" ")
 }
+
+// SARNESS: the persistent line under the composer: Model · Effort · Server · Permission mode.
+// Values are the live ones: model/variant from the TUI's current selection, server and mode from the
+// sarness launcher (the mode is the one the generated permission rules enforce; auto-accept shows as such).
+export function SarnessInfoLine(props: {
+  mode: "normal" | "shell"
+  agent?: string
+  auto: boolean
+  model: string
+  variant?: string
+  highlight: RGBA
+  muted: boolean
+}) {
+  const theme = useTheme()
+  const dimensions = useTerminalDimensions()
+  const permission = createMemo(() => sarnessModeLabel(SarnessLaunch.mode, props.auto))
+  const server = createMemo(() =>
+    SarnessLaunch.server ? SarnessLaunch.server.charAt(0).toUpperCase() + SarnessLaunch.server.slice(1) : undefined,
+  )
+  const layout = createMemo(() => {
+    const width = Math.max(10, dimensions().width - 8)
+    const effort = props.mode === "shell" ? "Shell" : sarnessEffortLabel(props.variant)
+    const tail = (agent: boolean, srv: boolean) =>
+      [effort, srv ? server() : undefined, permission(), agent ? props.agent?.toLowerCase() : undefined].filter(
+        (item): item is string => Boolean(item),
+      )
+    for (const [agent, srv] of [
+      [true, true],
+      [false, true],
+      [false, false],
+    ] as const) {
+      const rest = tail(agent, srv)
+      if (stringWidth([props.model, ...rest].join(" · ")) <= width) return { model: props.model, rest, agent }
+    }
+    const rest = tail(false, false)
+    const room = Math.max(9, width - stringWidth(rest.join(" · ")) - 3)
+    return { model: Locale.truncateWidth(props.model, room).replace(/\s+…$/, "…"), rest, agent: false }
+  })
+  const color = (item: string) => {
+    if (item === permission()) {
+      if (item === "BYPASS" || item === "AUTO-ACCEPT") return theme.text.feedback.warning.base
+      return theme.hue.accent[300]
+    }
+    if (layout().agent && item === props.agent?.toLowerCase()) return props.highlight
+    return theme.text.muted
+  }
+  return (
+    <box flexDirection="row" flexShrink={1} minWidth={0} height={1}>
+      <text wrapMode="none" truncate fg={props.muted ? theme.text.muted : theme.text.base}>
+        {layout().model}
+        <For each={layout().rest}>
+          {(item) => (
+            <>
+              <span style={{ fg: theme.text.muted }}>{" · "}</span>
+              <span style={{ fg: color(item) }}>{item}</span>
+            </>
+          )}
+        </For>
+      </text>
+    </box>
+  )
+}
