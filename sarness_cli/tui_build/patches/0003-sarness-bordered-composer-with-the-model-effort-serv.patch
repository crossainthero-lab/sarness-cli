diff --git a/packages/tui/src/sarness.ts b/packages/tui/src/sarness.ts
new file mode 100644
index 0000000..8cc73fa
--- /dev/null
+++ b/packages/tui/src/sarness.ts
@@ -0,0 +1,55 @@
+import { spawn } from "node:child_process"
+import { existsSync } from "node:fs"
+import type { CliRenderer } from "@opentui/core"
+
+// SARNESS: facts the `sarness` launcher passes to this terminal (see sarness-cli openai_bridge.py).
+// Only display data lives here; every setting is still enforced by the generated config and the bridge.
+
+export const SarnessLaunch = {
+  /** Engine profile name, e.g. "spark". */
+  server: process.env.SARNESS_SERVER || undefined,
+  /** Sarness permission mode the generated OpenCode permission rules were built from: ask | auto | full-access | bypass. */
+  mode: process.env.SARNESS_MODE || undefined,
+  /** Absolute path of the `sarness` executable, for delegated commands such as /cabinet. */
+  bin: process.env.SARNESS_BIN || undefined,
+  /** Effort the bridge applies when no variant is selected (the Sarness `effort` setting). */
+  effort: process.env.SARNESS_EFFORT || undefined,
+  /** Version of the Sarness CLI that launched this terminal. */
+  version: process.env.SARNESS_VERSION || undefined,
+}
+
+export function sarnessModeLabel(mode: string | undefined, autoaccept: boolean) {
+  if (autoaccept && mode !== "bypass") return "AUTO-ACCEPT"
+  if (!mode) return undefined
+  return mode === "full-access" ? "FULL ACCESS" : mode.toUpperCase()
+}
+
+/** Effort is the OpenCode variant the bridge maps to engine parameters. Engine 0.4 only has thinking on/off. */
+export function sarnessEffortLabel(variant: string | undefined) {
+  const value = variant || SarnessLaunch.effort
+  if (!value) return "Default"
+  return value.charAt(0).toUpperCase() + value.slice(1)
+}
+
+/** Run a `sarness` subcommand in this terminal (TUI suspended), then wait for Enter so its output stays readable. */
+export async function runSarnessCommand(renderer: CliRenderer, args: string[], cwd?: string) {
+  const bin = SarnessLaunch.bin
+  if (!bin) throw new Error("This terminal was not started by `sarness`, so Sarness commands are unavailable")
+  renderer.suspend()
+  renderer.currentRenderBuffer.clear()
+  try {
+    await new Promise<void>((resolve, reject) => {
+      const child = spawn(
+        "/bin/sh",
+        ["-c", '"$0" "$@"; printf "\\n\\033[2m[Enter] back to Sarness\\033[0m "; read _', bin, ...args],
+        { cwd: cwd && existsSync(cwd) ? cwd : process.cwd(), stdio: "inherit" },
+      )
+      child.on("error", reject)
+      child.on("exit", () => resolve())
+    })
+  } finally {
+    renderer.currentRenderBuffer.clear()
+    renderer.resume()
+    renderer.requestRender()
+  }
+}
